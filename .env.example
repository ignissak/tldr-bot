# Discord application credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands to one guild (instant) instead of globally
DEV_GUILD_ID=

# 32 random bytes, base64. Generate: bun run keygen
# Losing/changing this makes stored Gemini keys unreadable (users must re-link).
ENCRYPTION_KEY=

DATABASE_PATH=./data/bot.db
# Hard caps for /tldr input (cost + latency guard)
TLDR_MAX_MESSAGES=3000
TLDR_MAX_INPUT_CHARS=200000
# Timezone for /tldr dates when a user hasn't run /timezone (IANA name)
DEFAULT_TIMEZONE=UTC
