{
  "name": "tldr-discord-bot",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "deploy": "bun src/deploy-commands.ts",
    "keygen": "bun -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "discord.js": "^14.27.0",
    "zod": "^4.6.5"
  }
}
